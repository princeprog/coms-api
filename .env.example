DATABASE_URL=postgresql://user:password@localhost:5432/coms
PORT=3001
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-64-random-hex-characters
JWT_REFRESH_SECRET=replace-with-different-64-random-hex-characters
COMS_AUTH_GATEWAY_SECRET=replace-with-third-64-random-hex-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=coms-api
JWT_AUDIENCE=coms-web
AUTH_LOGIN_LIMIT_PER_MINUTE=10
AUTH_REFRESH_LIMIT_PER_MINUTE=20
AUTH_CAPACITY_LIMIT_PER_MINUTE=600
